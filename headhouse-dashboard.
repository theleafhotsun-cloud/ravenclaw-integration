<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Headhouse Dashboard - Ravenclaw</title>
  <style>
    body { font-family: Arial, sans-serif; background-color: #f4f7f6; padding: 20px; }
    .container { max-width: 800px; margin: 0 auto; background: white; padding: 30px; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
    h1 { color: #0056b3; }
    .user-info { background: #e9ecef; padding: 15px; border-radius: 5px; margin-bottom: 20px; }
    button.logout { background: #dc3545; color: white; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; }
  </style>
</head>
<body>

  <div class="container">
    <h1>Welcome to Headhouse Dashboard</h1>
    
    <div class="user-info">
      <p><strong>Logged in as:</strong> <span id="display-username">Loading...</span></p>
      <p><strong>Role:</strong> <span id="display-role">Loading...</span></p>
    </div>

    <p>This is your secure dashboard area. Content goes here.</p>

    <button class="logout" onclick="logout()">Logout</button>
  </div>

  <script>
    // 1. Ambil data sesi yang disimpan saat login
    const savedUsername = localStorage.getItem("session_username");
    const savedRole = localStorage.getItem("session_role");

    // 2. Proteksi Halaman: Tendang kembali ke login jika tidak ada sesi
    if (!savedUsername || savedRole !== "Headhouse") {
      alert("Access Denied! Please login first.");
      window.location.href = "index.html";
    } else {
      // 3. Tampilkan nama pengguna di layar
      document.getElementById("display-username").innerText = savedUsername;
      document.getElementById("display-role").innerText = savedRole;
    }

    // Fungsi Logout
    function logout() {
      localStorage.clear(); // Hapus sesi
      window.location.href = "index.html"; // Kembali ke halaman login
    }
  </script>

</body>
</html>
